cabal-version:      3.0
name:               exercicios-lambda
version:            0.1.0.0
synopsis:           Exercícios práticos sobre expressões lambda e aplicação parcial.
description:        Atividade prática em Haskell para exercitar expressões lambda,
                    aplicação parcial, seções de operadores e processamento de
                    dados com funções de ordem superior.
license:            MIT
license-file:       LICENSE
author:             Prof. José Romildo Malaquias
maintainer:         malaquias@ufop.edu.br
category:           Learning
build-type:         Simple
extra-source-files: README.md
                  , cabal.project
                  , .hlint.yaml
                  , .github/workflows/classroom.yml
                  , .github/classroom/autograding.json

common common-deps
    build-depends:    base >= 4.7 && < 5
    default-language: Haskell2010
    ghc-options:      -Wall -Wcompat

library
    import:           common-deps
    exposed-modules:  Exercicios
    hs-source-dirs:   src

executable exercicios-lambda
    import:           common-deps
    main-is:          Main.hs
    hs-source-dirs:   app
    build-depends:    exercicios-lambda

test-suite tests
    import:           common-deps
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          MainSpec.hs
    build-depends:    exercicios-lambda
                    , hspec
                    , QuickCheck
