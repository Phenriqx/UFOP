cabal-version:      3.0
name:               refeicao-saudavel
version:            1.0.0
synopsis:           Refeição saudável
description:        Atividade de programação interativa em Haskell.
license:            MIT
license-file:       LICENSE
author:             Professor
maintainer:         professor@example.com
category:           Education
build-type:         Simple
extra-source-files: README.md
                    LICENSE

library
    default-language: Haskell2010
    hs-source-dirs:   src
    exposed-modules:  RefeicaoSaudavel
    build-depends:    base
    ghc-options:      -Wall

executable refeicao-saudavel
    default-language: Haskell2010
    hs-source-dirs:   app
    main-is:          Main.hs
    build-depends:    base
                    , refeicao-saudavel
    ghc-options:      -Wall

test-suite tests
    default-language: Haskell2010
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          MainSpec.hs
    other-modules:    Run
    build-depends:    base
                    , refeicao-saudavel
                    , hspec
                    , QuickCheck
                    , process
                    , temporary
    ghc-options:      -Wall
